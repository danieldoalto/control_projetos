# Exemplo de variáveis de ambiente para o ctrl_prj
# Renomeie ou copie este arquivo para .env e insira suas credenciais:
# cp .env.example .env

# Chave de API do OpenRouter (obrigatória para provedor openrouter)
OPENROUTER_API_KEY=sk-or-v1-seu-token-aqui

# Outros provedores suportados:
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...
